    }
  ],
  "r2_buckets": [
    {
      "binding": "SAVES",
      "bucket_name": "lucineer-saves"
    }
  ],
  "vars": {
    "LUCINEER_SHARED_SECRET": "a3db66d2381c97674f25a8f1b3f8d0a938d889723b121d9625566d074362f734"
  },
  "observability": {
    "enabled": true
  }
}
